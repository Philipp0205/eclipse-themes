<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- The only trigger that activates this bundle: nothing else in the IDE refers
        to it. It doubles as the off switch, since Preferences > General > Startup
        and Shutdown lists every early startup contribution with a check box. -->
   <extension point="org.eclipse.ui.startup">
      <startup class="com.vogella.eclipse.themes.gtk.GtkThemeStartup"/>
   </extension>
</plugin>
