Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-SymbolicName: com.vogella.eclipse.themes.gtk;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: com.vogella.eclipse.themes.gtk
Eclipse-PlatformFilter: (osgi.ws=gtk)
Require-Bundle: org.eclipse.core.runtime;bundle-version="3.20.0",
 org.eclipse.swt;bundle-version="3.120.0",
 org.eclipse.ui;bundle-version="3.100.0",
 org.eclipse.e4.ui.css.swt.theme;bundle-version="0.12.0"
Import-Package: org.osgi.framework;version="[1.8.0,2.0.0)",
 org.osgi.service.event;version="[1.3.0,2.0.0)",
 org.osgi.service.prefs;version="[1.1.0,2.0.0)"
