<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="com.vogella.eclipse.themes.gtk.feature"
      label="vogella Themes for GTK Widgets"
      version="1.0.0.qualifier"
      provider-name="vogella GmbH">

   <description>
      Colors the widgets SWT hands to GTK, which the Eclipse CSS engine cannot reach: tree and table
      selections, scrollbars, menus, tooltips, check box and radio button indicators and the native
      dialogs. Installs on Linux only, and follows whichever vogella theme is active.
   </description>

   <copyright>
      Copyright (c) 2026 vogella GmbH and others.
   </copyright>

   <license url="https://www.eclipse.org/legal/epl-2.0/">
      Eclipse Public License 2.0
   </license>

   <!-- ws="gtk" as well as the bundle's own Eclipse-PlatformFilter. The filter alone
        would make this requirement unsatisfiable when the repository is assembled for
        win32 and macosx, because Tycho takes a feature's plugin filter from these
        attributes and not from the manifest. -->
   <plugin id="com.vogella.eclipse.themes.gtk" ws="gtk" download-size="0" install-size="0" version="0.0.0"/>

</feature>
